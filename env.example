# Copia questo file come .env per test locali
# Su Railway aggiungi queste variabili nella sezione "Variables"

# Token del bot Telegram (da @BotFather)
TELEGRAM_TOKEN=inserisci_qui_il_tuo_token

# Il tuo chat ID Telegram (numerico)
CHAT_ID=inserisci_qui_il_tuo_chat_id

# ── Facoltative ──────────────────────────────────────────────────────────────
# Strategie da spegnere, separate da virgola (es. orb_cat,orb_avgo)
# STRATEGIE_SPENTE=

# File della memoria del bot. Di default /data/stato.json se esiste il volume /data,
# altrimenti stato.json accanto al codice (su Railway si perde a ogni deploy).
# STATO_PATH=/data/stato.json

# Ticker Yahoo dei titoli singoli e short abilitati ("1" o "0")
# TICKER_ANT=ANT
# TICKER_CAT=CAT
# TICKER_AVGO=AVGO
# ANT_ABILITA_SHORT=0
# CAT_ABILITA_SHORT=1
# AVGO_ABILITA_SHORT=1

# Rischio per segnale e limite totale in % del capitale (per il calcolo "Già aperti")
# RISCHIO_PER_TRADE=1.5
# MAX_RISCHIO_TOTALE=4
